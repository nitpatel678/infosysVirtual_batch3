# ==============================================================================
# SentryAI Backend - Environment Variables Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)

# ------------------------------------------------------------------------------
# 🐘 1. Neon DB (Serverless PostgreSQL) - RECOMMENDED DATABASE
# ------------------------------------------------------------------------------
# SentryAI uses Neon DB (serverless PostgreSQL) for cloud persistence, JSONB audit
# logs, and sub-3ms GIN full-text vector retrieval.
#
# How to get your free database:
# 1. Sign up for free at: https://neon.tech
# 2. Click "Create Project" (choose your closest AWS region)
# 3. In your Neon Dashboard, copy the "Connection String" (Pooled or Direct)
# 4. Paste it below (ensure it ends with ?sslmode=require):
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-subdomain-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Note: If DATABASE_URL is left blank, SentryAI will automatically fall back to an
# embedded local SQLite database (evaluations_fallback.db) for testing.

# ------------------------------------------------------------------------------
# 🚀 2. Retrieval Mode (Neon DB Cloud Full-Text Search vs Local FAISS)
# ------------------------------------------------------------------------------
# - Set to 'true' (Recommended): Offloads search directly to Neon DB GIN index.
#   Uses 0 MB local RAM (ideal for Render 512 MB free tier and cloud hosting).
# - Set to 'false': Runs dense vector search locally using FAISS + all-MiniLM-L6-v2
#   (requires PyTorch and ~400 MB of local RAM).
USE_DB_RETRIEVAL=true

# ------------------------------------------------------------------------------
# 🤖 3. OpenAI API Key (Primary Multi-Agent Evaluation Engine)
# ------------------------------------------------------------------------------
# Powers GPT-4o-mini for high-precision multi-agent adjudication.
# Get your API key from: https://platform.openai.com/api-keys
OPEN_AI_API_KEY=sk-proj-your-openai-api-key-here

# ------------------------------------------------------------------------------
# ♊ 4. Google Gemini API Key (Secondary Multi-Agent Evaluation Engine)
# ------------------------------------------------------------------------------
# Powers Gemini 1.5 Flash. Supports automatic key rotation when rate limits occur.
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_2=your-second-gemini-api-key   # Optional: backup key for rotation
GEMINI_API_KEY_3=your-third-gemini-api-key    # Optional: backup key for rotation

# ------------------------------------------------------------------------------
# 🌐 5. Server Port
# ------------------------------------------------------------------------------
PORT=8000
