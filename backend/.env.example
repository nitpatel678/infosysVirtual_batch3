# ==============================================================================
# SentryAI Backend - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your API keys and database credentials.

# 1. Primary AI Model Engine (OpenAI)
# Get your key from: https://platform.openai.com/api-keys
OPEN_AI_API_KEY=sk-proj-your-openai-api-key-here

# 2. Secondary AI Model Engine (Google Gemini)
# Get your key from: https://aistudio.google.com/app/apikey
# Multiple keys are supported for automatic rotation when rate limits are hit:
GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_2=your-second-gemini-api-key
GEMINI_API_KEY_3=your-third-gemini-api-key

# 3. Database Connection String (PostgreSQL / NeonDB)
# Free serverless PostgreSQL: https://neon.tech
# If omitted or left empty, SentryAI will automatically fall back to local SQLite!
DATABASE_URL=postgresql://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require

# 4. Retrieval Architecture Mode
# Set to 'true' in cloud/production (e.g. Render free tier) to query NeonDB GIN search (0 MB local RAM).
# Set to 'false' in local dev to run dense vector search via local FAISS index (requires PyTorch & sentence-transformers).
USE_DB_RETRIEVAL=true

# 5. Server Port (default: 8000)
PORT=8000
